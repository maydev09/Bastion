[Unit]
Description=Bastion (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# The first start and 3 retries; a stack that keeps failing stays stopped until it is fixed.
StartLimitIntervalSec=15min
StartLimitBurst=4

[Service]
Type=exec
WorkingDirectory=/opt/bastion
# Decrypted from /etc/credstore.encrypted/ into $CREDENTIALS_DIRECTORY, read by compose.sh (ADR 0010).
LoadCredentialEncrypted=db-postgres-password
LoadCredentialEncrypted=db-owner-password
LoadCredentialEncrypted=db-app-password
LoadCredentialEncrypted=wireguard-private-key
# Readable copies of the secrets for the containers, in memory (see compose.sh).
RuntimeDirectory=bastion
RuntimeDirectoryMode=0700
Environment=COMPOSE_FILE=compose.yaml:deploy/compose.server.yaml
ExecStartPre=/opt/bastion/deploy/compose.sh run --rm migrate
# Foreground, so container logs go to the journal. When any container exits, Compose stops all of
# them and systemd starts the whole stack again in order (the app needs a fresh vpn network).
ExecStart=/opt/bastion/deploy/compose.sh up --remove-orphans --abort-on-container-exit
ExecStop=/opt/bastion/deploy/compose.sh down
# `compose up` exits with 130 when it is stopped; that is a clean stop, not a failure.
SuccessExitStatus=130
TimeoutStartSec=300
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
