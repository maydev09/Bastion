<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../Web/Shared/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Platform/Bastion.Platform.Abstractions/Bastion.Platform.Abstractions.csproj" />
    <ProjectReference Include="../../Modules/FlatOffers/Bastion.Modules.FlatOffers/Bastion.Modules.FlatOffers.csproj" />
    <ProjectReference Include="../../Modules/JobOffers/Bastion.Modules.JobOffers/Bastion.Modules.JobOffers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="bastion*.toml" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Bastion.IntegrationTests" />
  </ItemGroup>
</Project>
