        "fetched": "Fetched",
        "failed": "Failed",
        "removed": "Removed from the portal",
        "retried": "Retried"
      }
    },
    "ReparseOffers": {
      "name": "Process the stored pages again",
      "description": "Reads the offers again from the stored pages, without contacting OtoDom. Run it after a fix in reading the pages; it recalculates the monthly costs at the end.",
