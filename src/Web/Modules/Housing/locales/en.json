        "pages": "Pages",
        "failedPages": "Failed pages",
        "added": "New",
        "updated": "Changed",
        "unchanged": "Unchanged",
        "skipped": "Skipped",
        "detailPages": "Detail pages"
      }
    },
    "ImportPlaces": {
      "name": "Fetch the place dictionary",
      "description": "Downloads the dictionary of places from Wikidata: town or village, population, the nearest bigger cities. Offers stay as they are. Takes a minute or two.",
