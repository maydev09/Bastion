{
  "openapi": "3.1.1",
  "info": {
    "title": "Bastion.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/platform/modules": {
      "get": {
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/database": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Connects as the application role and returns the server version, whether the role can change the schema, and the last migration of every module.",
        "operationId": "GetDatabaseStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/import/{source}": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Fetches one live results page of the source, stores it as raw data, saves new offers and updates changed ones.",
        "operationId": "ImportHousingOffers",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/reparse": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Parses all stored raw pages again, oldest first, and saves the offers. Nothing is fetched.",
        "operationId": "ReparseHousingOffers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReparseResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/offers": {
      "get": {
        "tags": [
          "Housing"
        ],
        "summary": "Returns stored offers, newest first.",
        "operationId": "ListHousingOffers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfOfferListItem"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/jobs/{job}/runs": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Starts the job in the background, or returns its run that is already queued or running.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRun"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/jobs/{job}/runs/latest": {
      "get": {
        "tags": [
          "Housing"
        ],
        "summary": "Returns the latest run of the job (null before the first run) and the server's current time.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestJobRun"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Currency": {
        "enum": [
          "PLN",
          null
        ]
      },
      "DatabaseStatus": {
        "required": [
          "user",
          "serverVersion",
          "canChangeSchema",
          "migrations"
        ],
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "serverVersion": {
            "type": "string"
          },
          "canChangeSchema": {
            "type": "boolean"
          },
          "migrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SchemaMigration"
            }
          }
        }
      },
      "ImportResult": {
        "required": [
          "source",
          "pageCount",
          "addedCount",
          "updatedCount",
          "unchangedCount",
          "skippedCount"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "pageCount": {
            "type": "integer",
            "format": "int32"
          },
          "addedCount": {
            "type": "integer",
            "format": "int32"
          },
          "updatedCount": {
            "type": "integer",
            "format": "int32"
          },
          "unchangedCount": {
            "type": "integer",
            "format": "int32"
          },
          "skippedCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "JobRun": {
        "required": [
          "id",
          "job",
          "trigger",
          "status",
          "queuedAt",
          "startedAt",
          "finishedAt",
          "errorCode",
          "summary"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "job": {
            "type": "string"
          },
          "trigger": {
            "$ref": "#/components/schemas/JobTrigger"
          },
          "status": {
            "$ref": "#/components/schemas/JobRunStatus"
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "summary": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobSummary"
              }
            ]
          }
        }
      },
      "JobRunStatus": {
        "enum": [
          "Queued",
          "Running",
          "Succeeded",
          "Failed",
          "Cancelled",
          "Interrupted"
        ]
      },
      "JobSummary": {
        "required": [
          "counts"
        ],
        "type": "object",
        "properties": {
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "JobTrigger": {
        "enum": [
          "Manual",
          "Schedule"
        ]
      },
      "LatestJobRun": {
        "required": [
          "run",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "run": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobRun"
              }
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ModuleInfo": {
        "required": [
          "name",
          "routePrefix"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "routePrefix": {
            "type": "string"
          }
        }
      },
      "OfferListItem": {
        "required": [
          "id",
          "source",
          "title",
          "url",
          "propertyType",
          "transaction",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "propertyType": {
            "$ref": "#/components/schemas/PropertyType"
          },
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          },
          "price": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "priceCurrency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Currency"
              }
            ]
          },
          "areaM2": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "rooms": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "externalCreatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "externalUpdatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "PagedResultOfOfferListItem": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferListItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PropertyType": {
        "enum": [
          "Flat"
        ]
      },
      "ReparseResult": {
        "required": [
          "captureCount",
          "failedCount",
          "addedCount",
          "updatedCount",
          "unchangedCount",
          "skippedCount"
        ],
        "type": "object",
        "properties": {
          "captureCount": {
            "type": "integer",
            "format": "int32"
          },
          "failedCount": {
            "type": "integer",
            "format": "int32"
          },
          "addedCount": {
            "type": "integer",
            "format": "int32"
          },
          "updatedCount": {
            "type": "integer",
            "format": "int32"
          },
          "unchangedCount": {
            "type": "integer",
            "format": "int32"
          },
          "skippedCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SchemaMigration": {
        "required": [
          "schema",
          "version"
        ],
        "type": "object",
        "properties": {
          "schema": {
            "type": "string"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Source": {
        "enum": [
          "OtoDom"
        ]
      },
      "Transaction": {
        "enum": [
          "Rent"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "Housing"
    }
  ]
}