{
  "openapi": "3.1.1",
  "info": {
    "title": "Bastion.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/platform/modules": {
      "get": {
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/database": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Connects as the application role and returns the server version, whether the role can change the schema, and the last migration of every module.",
        "operationId": "GetDatabaseStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/import/{source}": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Fetches one live results page of the source, stores it as raw data, saves new offers and updates changed ones.",
        "operationId": "ImportHousingOffers",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Source"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/reparse": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Parses all stored raw pages again, oldest first, and saves the offers. Nothing is fetched.",
        "operationId": "ReparseHousingOffers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReparseResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/offers": {
      "get": {
        "tags": [
          "Housing"
        ],
        "summary": "Returns stored offers, by default newest first; offers without the sorted value come last.",
        "operationId": "ListHousingOffers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": "FirstSeen",
              "$ref": "#/components/schemas/OfferSort"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "default": "Descending",
              "$ref": "#/components/schemas/SortDirection"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfOfferListItem"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/offers/{id}": {
      "get": {
        "tags": [
          "Housing"
        ],
        "summary": "Returns one stored offer with its place and the nearest big cities, also a removed one.",
        "operationId": "GetHousingOffer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferListItem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/housing/jobs/{job}/runs": {
      "post": {
        "tags": [
          "Housing"
        ],
        "summary": "Starts the job in the background, or returns its run that is already queued or running.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRun"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/housing/jobs/{job}/runs/latest": {
      "get": {
        "tags": [
          "Housing"
        ],
        "summary": "Returns the latest run of the job (null before the first run) and the server's current time.",
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestJobRun"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
