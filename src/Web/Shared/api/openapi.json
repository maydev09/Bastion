{
  "openapi": "3.1.1",
  "info": {
    "title": "Bastion.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/platform/modules": {
      "get": {
        "tags": [
          "Platform"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/database": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Connects as the application role and returns the server version, whether the role can change the schema, and the last migration of every module.",
        "operationId": "GetDatabaseStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/flat-offers/import": {
      "post": {
        "tags": [
          "FlatOffers"
        ],
        "summary": "Fetches one live OtoDom results page, saves new offers and updates changed ones.",
        "operationId": "ImportFlatOffers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/flat-offers/offers": {
      "get": {
        "tags": [
          "FlatOffers"
        ],
        "summary": "Returns stored offers, newest first.",
        "operationId": "ListFlatOffers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfOfferListItem"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "required": [
          "user",
          "serverVersion",
          "canChangeSchema",
          "migrations"
        ],
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "serverVersion": {
            "type": "string"
          },
          "canChangeSchema": {
            "type": "boolean"
          },
          "migrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SchemaMigration"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ImportResult": {
        "required": [
          "source",
          "addedCount",
          "updatedCount",
          "unchangedCount",
          "skippedCount"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/OfferSource"
          },
          "addedCount": {
            "type": "integer",
            "format": "int32"
          },
          "updatedCount": {
            "type": "integer",
            "format": "int32"
          },
          "unchangedCount": {
            "type": "integer",
            "format": "int32"
          },
          "skippedCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ModuleInfo": {
        "required": [
          "name",
          "routePrefix"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "routePrefix": {
            "type": "string"
          }
        }
      },
      "OfferListItem": {
        "required": [
          "id",
          "source",
          "title",
          "url",
          "firstSeenAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "source": {
            "$ref": "#/components/schemas/OfferSource"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "price": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "priceCurrency": {
            "type": [
              "null",
              "string"
            ]
          },
          "areaM2": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "rooms": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OfferSource": {
        "enum": [
          "OtoDom"
        ]
      },
      "PagedResultOfOfferListItem": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferListItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SchemaMigration": {
        "required": [
          "schema",
          "version"
        ],
        "type": "object",
        "properties": {
          "schema": {
            "type": "string"
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "FlatOffers"
    }
  ]
}